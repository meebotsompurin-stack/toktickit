# TokTickIT Client Environment Configuration
# Note: In development mode, Vite automatically proxies all requests starting with /api
# to the Express backend server at http://localhost:3000 (configured in vite.config.ts).
# No frontend environment variables are strictly required for local development.

# Optional: Production API Base URL (if frontend and backend are hosted on separate origins)
# VITE_API_URL=http://localhost:3000
